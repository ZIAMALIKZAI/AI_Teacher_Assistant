# Google AI Studio API Key (Free tier has 1M token context window)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Vector DB Configuration (:memory: for local zero-config)
QDRANT_LOCATION=:memory:
QDRANT_COLLECTION=teacher_knowledge_base

# Embedding Model (Sentence Transformers run locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Custom Tesseract path for Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
